# ─── LLM Providers ────────────────────────────────────────────────────────────
# Primary: Groq (fast, free tier). Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback: Claude (Anthropic). Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fallback: OpenAI. Get your key at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Which provider to use first: "groq" | "claude" | "openai"
LLM_PROVIDER=groq

# ─── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite — no install needed, file created automatically)
DATABASE_URL=sqlite:///./context_engine.db

# Production (PostgreSQL — uncomment and fill in when deploying)
# DATABASE_URL=postgresql://user:password@localhost:5432/context_engine

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# Max messages to send to the LLM (smart truncation kicks in above this)
MAX_MESSAGES=25

# CORS origins (comma-separated). Use * for local dev only.
CORS_ORIGINS=*
